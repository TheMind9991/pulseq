# --- Firebase client SDK (public — safe to expose to the browser) ---
# From: Firebase Console > Project settings > General > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase admin SDK (server-only secret — never expose to the browser) ---
# From: Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON as-is (including literal \n sequences).
FIREBASE_PRIVATE_KEY=

# --- Google AdSense (public — Section 7.1) ---
# Left blank in dev: AdSlot still reserves its layout space but shows no ad script and no ad unit.
# From: AdSense account > Sites (client ID, "ca-pub-...") and Ads > By ad unit (slot ID).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# --- Paymob (server-only secrets — Section 7.4) ---
# From: Paymob dashboard > Settings > Account Info (API key) and > Payment Integrations (integration
# ID) and > Webhooks (HMAC secret). PAYMOB_IFRAME_ID is under Developers > iframes.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# --- Local dev against the Firebase emulators (no real project needed) — see SETUP.md ---
# Leave all of the above blank and set these instead to run entirely against
# `firebase emulators:start`. NEXT_PUBLIC_FIREBASE_API_KEY/PROJECT_ID still need *some* value —
# the emulators don't validate them, but the SDKs require the fields to be present.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pulseq
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
